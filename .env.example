# ── Auth ──
AUTH_SECRET=change-this-to-a-random-string-at-least-32-chars
SUPERADMIN_EMAIL=admin@clausr.ai
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-this

# ── LLM Provider ──
# Which API protocol to use: "openai", "anthropic", or "deepseek"
LLM_PROVIDER=deepseek

# DeepSeek API key (same key works for both OpenAI and Anthropic protocols)
LLM_API_KEY=sk-your-key-here

# Optional overrides (defaults shown per provider):
#   openai    → https://api.openai.com/v1
#   anthropic → https://api.anthropic.com/v1
#   deepseek  → https://api.deepseek.com
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash

# ── Database ──
# SQLite database file path (default: data/session.db)
DATABASE_PATH=data/skill-agent.db
AUTH_DB_PATH=data/auth.db

# ── SMS (optional, Volcengine) ──
# SMS_ENABLED=false
# VOLC_ACCESS_KEY=
# VOLC_SECRET_KEY=
# VOLC_REGION=cn-north-1
# VOLC_SMS_ACCOUNT=
# VOLC_SMS_SIGN=
# VOLC_SMS_TEMPLATE_ID=
# VOLC_SMS_SCENE=注册验证码

# ── Email (optional, Resend) ──
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@clausr.ai

# ── Deployment ──
# PACKS_DIR=/opt/clausr/packs