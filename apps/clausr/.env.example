# ── Auth ──
AUTH_SECRET=change-this-to-a-random-string-at-least-32-chars
SUPERADMIN_EMAIL=admin@clausr.ai

# ── LLM Provider ──
# Default: deepseek (use "openai" or "anthropic" to switch)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# ── Database ──
DATABASE_PATH=data/skill-agent.db
AUTH_DB_PATH=data/auth.db

# ── API Keys (set in production) ──
# Provider-specific (recommended):
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-your-anthropic-key
# Fallback (used when provider-specific key is missing):
# LLM_API_KEY=sk-your-key-here
