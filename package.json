{
  "name": "clausr-ai",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @clausr/app run dev",
    "build": "pnpm --filter @clausr/platform-core run build && pnpm --filter @clausr/app run build",
    "start": "pnpm --filter @clausr/app run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.5.1"
}